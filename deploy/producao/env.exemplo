# Copie para ".env" na raiz do projeto, no servidor, e preencha. NUNCA coloque no git.

# Endereço do site, sem https:// (o DNS precisa apontar para este servidor)
DOMINIO=

# Banco: invente uma senha longa
POSTGRES_PASSWORD=

# Gere com: openssl rand -hex 32
SEGREDO_JWT=

# Primeiro usuário (dono). Usado só por "python -m app.seed".
DONO_NOME=
DONO_EMAIL=
DONO_SENHA=

# Dados da loja mostrados no site (o que ficar vazio não aparece)
# WhatsApp: só dígitos, com DDD (ex.: 86999990000). Instagram: sem @.
LOJA_WHATSAPP=
LOJA_CIDADE=
LOJA_ENDERECO=
LOJA_HORARIO=
LOJA_INSTAGRAM=

# Consulta de placa: vazio = desligada (ainda não há provedor real)
PROCEDENCIA_PROVEDOR=
