# Copie para ".env" (na raiz) e ajuste. Usado pelo docker-compose.yml.
# NUNCA coloque o .env no git.

# --- Banco ---
POSTGRES_USER=rcmotos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=rcmotos

# --- API ---
# desenvolvimento | producao  (em producao o cookie de sessão exige HTTPS)
AMBIENTE=desenvolvimento
# Obrigatório em produção, mínimo 32 caracteres. Gere com: openssl rand -hex 32
SEGREDO_JWT=
# true = a interface avisa que os números são ilustrativos (dados do seed --demo)
DADOS_DEMO=false

# Consulta de procedência pela placa: vazio = desligada; "demonstracao" = resultados
# ILUSTRATIVOS (recusado em producao); "consultarplaca" = API da Consultar Placa (paga).
PROCEDENCIA_PROVEDOR=
# Conta da loja na Consultar Placa: e-mail da conta e chave de Minha Conta > API.
CONSULTARPLACA_EMAIL=
CONSULTARPLACA_API_KEY=
# Laudo completo da mesma placa feito há menos de N horas é reaproveitado, sem pagar de novo.
PROCEDENCIA_REUSO_HORAS=24

# IA do assistente (perguntas sobre vendas, estoque e financeiro). Contas no nome da loja.
# Provedor: groq (padrão; camada gratuita em console.groq.com) | anthropic (Claude, pago).
# Sem a chave do provedor escolhido, as perguntas ficam desligadas; o cadastro de veículo
# por mensagem continua funcionando.
IA_PROVEDOR=groq
# console.groq.com > API Keys
GROQ_API_KEY=
# console.anthropic.com > API Keys (só com IA_PROVEDOR=anthropic)
ANTHROPIC_API_KEY=
# Vazio = padrão do provedor (groq: openai/gpt-oss-120b; anthropic: claude-haiku-5-5).
IA_MODELO=

# --- Site público (o que ficar vazio não aparece no site) ---
# Endereço público do site (ex.: https://rcmotos.com.br): endereço canônico das páginas, sitemap.xml
# e robots.txt. Sem ele o sitemap sai vazio e a prévia do link usa o endereço pelo qual a página foi aberta.
SITE_URL=
# Só dígitos, com DDD (ex.: 86999990000)
LOJA_WHATSAPP=
LOJA_CIDADE=
LOJA_ENDERECO=
LOJA_HORARIO=
# Sem @
LOJA_INSTAGRAM=
# Aparecem no rodapé e na página de privacidade. CNPJ com ou sem pontuação; com dígito
# verificador errado ele é ignorado (não aparece).
LOJA_CNPJ=
LOJA_RAZAO_SOCIAL=

# --- Primeiro acesso (usado só por "python -m app.seed") ---
DONO_NOME=
DONO_EMAIL=
DONO_SENHA=

# --- Porta publicada na máquina ---
WEB_PORTA=3000
