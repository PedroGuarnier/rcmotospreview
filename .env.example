# Copie para ".env" (na raiz) e ajuste. Usado pelo docker-compose.yml.
# NUNCA coloque o .env no git.

# --- Banco ---
POSTGRES_USER=rcmotos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=rcmotos

# --- API ---
# desenvolvimento | producao  (em producao o cookie de sessão exige HTTPS)
AMBIENTE=desenvolvimento
# Obrigatório em produção, mínimo 32 caracteres. Gere com: openssl rand -hex 32
SEGREDO_JWT=
# true = a interface avisa que os números são ilustrativos (dados do seed --demo)
DADOS_DEMO=false

# Consulta de procedência pela placa: vazio = desligada; "demonstracao" = resultados
# ILUSTRATIVOS (recusado em producao). O provedor nacional entra aqui quando contratado.
PROCEDENCIA_PROVEDOR=

# --- Site público (o que ficar vazio não aparece no site) ---
# Endereço público do site, usado em SEO (ex.: https://rcmotos.com.br)
SITE_URL=
# Só dígitos, com DDD (ex.: 86999990000)
LOJA_WHATSAPP=
LOJA_CIDADE=
LOJA_ENDERECO=
LOJA_HORARIO=
# Sem @
LOJA_INSTAGRAM=

# --- Primeiro acesso (usado só por "python -m app.seed") ---
DONO_NOME=
DONO_EMAIL=
DONO_SENHA=

# --- Porta publicada na máquina ---
WEB_PORTA=3000
